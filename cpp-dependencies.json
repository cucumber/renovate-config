{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Update version variables in dependencies/*.version",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update version variables in dependencies/*.version. The format should look like this\n```\n<repo/org>@<digest> # <tag/ref>)\n```",
      "managerFilePatterns": [
        "/(^|/)dependencies/.+\\.version$/"
      ],
      "versioningTemplate": "semver",
      "datasourceTemplate": "github-tags",
      "matchStrings": [
        "(?<packageName>.+?)@(?<currentDigest>.+?)\\s+#\\s+(?<currentValue>.+)"
      ]
    }
  ]
}
