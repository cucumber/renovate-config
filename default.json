{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:minimumReleaseAgeNpm",
    ":rebaseStalePrs",
    ":automergeBranch",
    ":automergeMinor",
    "helpers:pinGitHubActionDigests",
    "github>cucumber/renovate-config:rate-limits",
    "github>cucumber/renovate-config:dependencies-cpm-cmake",
    "github>cucumber/renovate-config:go",
